{
  "name": "paperloom",
  "version": "0.9.0",
  "description": "A local-first paper library with an interactive research graph, PDF annotations and on-device translation.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-repository.mjs",
    "prepare:client": "node scripts/prepare-client.mjs",
    "demo": "node scripts/create-demo.mjs"
  },
  "keywords": [
    "paper-management",
    "research",
    "knowledge-graph",
    "pdf-reader",
    "local-first",
    "literature-review"
  ]
}
